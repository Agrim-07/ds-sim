# Copy this file to .env on the server and fill in real values. Never commit .env.

# 32 random bytes, base64. Generate with: npm run keygen
# Losing this key makes every stored account unreadable - back it up somewhere safe.
DS_SIM_MASTER_KEY=

# Public address Caddy should serve and fetch an HTTPS certificate for, e.g. dssim.duckdns.org
SITE_ADDRESS=
